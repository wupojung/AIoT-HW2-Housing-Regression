{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "default_analysis_id",
    "analyses"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "MOCK",
        "UNAVAILABLE",
        "PLANNED",
        "ERROR"
      ]
    },
    "default_analysis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "figure_id",
          "title",
          "status",
          "image_ref",
          "table_ref",
          "description",
          "finding",
          "limitations",
          "provenance_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "figure_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "VERIFIED",
              "MOCK",
              "UNAVAILABLE",
              "PLANNED",
              "ERROR"
            ]
          },
          "image_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "table_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "provenance_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
