{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "cv",
    "methods",
    "execution_runs",
    "configurations",
    "default_configuration_id",
    "charts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "MOCK",
        "UNAVAILABLE",
        "PLANNED",
        "ERROR"
      ]
    },
    "cv": {
      "type": "object",
      "required": [
        "training_rows",
        "fold_count",
        "protocol_id",
        "status"
      ],
      "properties": {
        "training_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fold_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "protocol_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "VERIFIED",
            "MOCK",
            "UNAVAILABLE",
            "SOURCE_REPORTED_NOT_VERIFIED"
          ]
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method_id",
          "label",
          "parameters"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "parameter_id",
                "label",
                "data_type"
              ],
              "properties": {
                "parameter_id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "data_type": {
                  "enum": [
                    "number",
                    "integer",
                    "string",
                    "boolean"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "execution_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "execution_run_id",
          "status"
        ],
        "properties": {
          "execution_run_id": {
            "type": "string",
            "minLength": 1
          },
          "source_manifest_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "VERIFIED",
              "MOCK",
              "UNAVAILABLE",
              "PLANNED",
              "ERROR"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "configuration_id",
          "execution_run_id",
          "method_id",
          "track_id",
          "params",
          "protocol_id",
          "status"
        ],
        "properties": {
          "configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_run_id": {
            "type": "string",
            "minLength": 1
          },
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "track_id": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          },
          "protocol_id": {
            "type": "string",
            "minLength": 1
          },
          "metadata_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^phases/phase-04/configurations/[a-z0-9][a-z0-9._-]*/metadata\\.json$"
          },
          "fold_tasks_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^phases/phase-04/configurations/[a-z0-9][a-z0-9._-]*/fold-tasks\\.json$"
          },
          "cv_metrics_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^phases/phase-04/configurations/[a-z0-9][a-z0-9._-]*/cv-metrics\\.json$"
          },
          "selected_features_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^phases/phase-04/configurations/[a-z0-9][a-z0-9._-]*/selected-features\\.json$"
          },
          "status": {
            "enum": [
              "VERIFIED",
              "MOCK",
              "UNAVAILABLE",
              "PLANNED",
              "ERROR"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "default_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reported_candidate_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chart_id",
          "chart_type",
          "points_ref",
          "status"
        ],
        "properties": {
          "chart_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "chart_type": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "points_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^phases/phase-04/charts/[a-z0-9][a-z0-9._-]*\\.json$"
          },
          "axes": {
            "type": [
              "object",
              "null"
            ]
          },
          "comparison_protocol": {
            "type": "object",
            "required": [
              "protocol_id"
            ],
            "properties": {
              "protocol_id": {
                "type": "string",
                "minLength": 1
              },
              "fold_count": {
                "type": "integer",
                "minimum": 1
              },
              "track_id": {
                "type": "string",
                "minLength": 1
              },
              "metric_source": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "target_unit": {
                "type": "string",
                "minLength": 1
              },
              "lower_is_better": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "VERIFIED",
                  "MOCK",
                  "UNAVAILABLE",
                  "PLANNED",
                  "ERROR",
                  "SOURCE_REPORTED_NOT_VERIFIED",
                  "SOURCE_REPORTED_VERIFIED_MATCH"
                ]
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "VERIFIED",
              "MOCK",
              "UNAVAILABLE",
              "PLANNED",
              "ERROR",
              "SOURCE_REPORTED_NOT_VERIFIED"
            ]
          }
        }
      }
    }
  }
}
