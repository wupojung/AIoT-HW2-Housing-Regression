{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "models",
    "readiness"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "MOCK",
        "UNAVAILABLE",
        "PLANNED",
        "ERROR"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "model_version",
          "source_execution_run_id",
          "source_configuration_id",
          "model_status",
          "input_schema_ref",
          "readiness"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "source_execution_run_id": {
            "type": "string",
            "minLength": 1
          },
          "source_configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "model_status": {
            "type": "string",
            "minLength": 1
          },
          "input_schema_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "readiness": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "predict_enabled",
        "reason_code",
        "message"
      ],
      "properties": {
        "predict_enabled": {
          "type": "boolean"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
