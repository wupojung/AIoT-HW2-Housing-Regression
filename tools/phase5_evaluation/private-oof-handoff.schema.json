{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/regscope/private-oof-handoff.schema.json",
  "title": "Private Phase 4 OOF Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "execution_run_id", "protocol_id", "protocol_version",
    "population", "target", "source_artifacts", "csv", "row_count",
    "n_per_configuration", "expected_fold_ids", "configurations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "execution_run_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "population": {"const": "development_oof"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "unit"],
      "properties": {"column": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}}
    },
    "source_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "summary_sha256", "oof_sha256"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "oof_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "csv": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "columns"],
      "properties": {
        "path": {"const": "oof.csv"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "columns": {"const": ["row_id", "configuration_id", "fold_index", "task_id", "actual", "predicted"]}
      }
    },
    "row_count": {"type": "integer", "minimum": 1},
    "n_per_configuration": {"type": "integer", "minimum": 1},
    "expected_fold_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "configurations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["configuration_id", "config_hash", "method_id", "track_id", "status", "fold_tasks"],
        "properties": {
          "configuration_id": {"type": "string", "pattern": "^cfg-[0-9a-f]{64}$"},
          "config_hash": {"$ref": "#/$defs/sha256"},
          "method_id": {"type": "string", "minLength": 1},
          "track_id": {"enum": ["primary", "baseline"]},
          "status": {"const": "COMPLETED"},
          "fold_tasks": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["fold_index", "task_id"],
              "properties": {"fold_index": {"type": "integer", "minimum": 0}, "task_id": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
